<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View"/>
        <import type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel"/>
        <variable
                name="uimodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel" />
        <variable
                name="auxmodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.AuxButtonsModel" />
    </data>

    <com.particlesdevs.photoncamera.ui.camera.CameraLayout
            android:id="@+id/textureHolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:animateLayoutChanges="true">

        <!--    Block 1-->
        <!--    Contains viewfinder,bottombar and manualbar-->
        <!--    this boxing has been done in order to exclude topbar from layout parameter adjustments-->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/camera_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:animateLayoutChanges="true"
                app:adjustCameraContainer="@{uimodel.screenAspectRatio}"
                app:layout_constraintTop_toBottomOf="@+id/layout_topbar">


            <!--    Block 1.1-->
            <!--    includes the Layout resource of ViewFinder-->
            <include
                    android:id="@+id/layout_viewfinder"
                    layout="@layout/layout_main_viewfinder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintBaseline_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

            <!--    Block 1.2-->
            <!--    Dummy reference view with programmable aspect ratio. This acts as an anchor view for bottom buttons-->
            <FrameLayout
                    android:id="@+id/dummy_reference_view"
                    android:layout_width="match_parent"
                    app:setAspectRatio="@{uimodel.dummyAspectRatio}"
                    android:layout_height="0dp"
                    tools:visibility="visible"
                    android:clickable="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBaseline_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

            <!--    Block 1.3-->
            <!--   includes the Layout resource of Aux Buttons palette-->
            <com.particlesdevs.photoncamera.ui.camera.views.AuxButtonsLayout
                    android:id="@+id/aux_buttons_container"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/aux_container_background"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintWidth_percent="0.546"
                    app:layout_constraintBottom_toBottomOf="@id/dummy_reference_view"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    setAuxButtonModel="@{auxmodel}"
                    setActiveId="@{auxmodel.currentCameraId}"
                    bindViewGroupChildrenRotate="@{uimodel}"
                    hideAuxButtons="@{uimodel.sheetLevel != CameraFragmentModel.SHEET_HIDDEN}"
                    android:layout_marginBottom="18dp"
                    android:elevation="4dp" />

            <!--    Block 1.4-->
            <!--   includes the Layout resource of Manual Mode palette-->
            <include
                    android:id="@+id/manual_mode"
                    layout="@layout/manual_palette"
                    android:visibility="@{uimodel.sheetLevel == CameraFragmentModel.SHEET_HIDDEN ? View.VISIBLE : View.INVISIBLE}"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/aux_buttons_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="8dp"
                    tools:visibility="visible"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintVertical_bias="1.0" />

            <com.particlesdevs.photoncamera.ui.camera.views.FavoriteSettingsButton
                android:tag="favorite_settings"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="20dp" android:layout_marginBottom="8dp"
                android:elevation="5dp"
                android:visibility="@{uimodel.sheetLevel == CameraFragmentModel.SHEET_HIDDEN ? View.VISIBLE : View.INVISIBLE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/manual_mode" />

            <!--    Block 1.5-->
            <!--   arrow-->

            <ImageView
                    android:id="@+id/open_close_manual"
                    android:layout_width="@dimen/arrow_size"
                    android:layout_height="@dimen/arrow_size"
                    android:background="@drawable/chevron_up"
                    android:elevation="8dp"
                    android:contentDescription="Arrow"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/layout_bottombar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginBottom="8dp" />

            <!--    Block 1.6-->
            <!--    includes the Layout resource of BottomBar-->
            <include
                    android:id="@+id/layout_bottombar"
                    layout="@layout/layout_main_bottombar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dummy_reference_view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="0.0" />

            <!--    Block 1.7-->
            <!--    settings bottom sheet (HIDDEN / PEEK / FULL) above the bottom bar-->
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/settings_sheet_container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:elevation="@dimen/standard_20"
                    android:clickable="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/layout_bottombar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <!-- peekHeight is provisional until the quick row and group cells measure it -->
                <com.particlesdevs.photoncamera.ui.camera.views.settingsbar.SettingsBarLayout
                        android:id="@+id/settings_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_behavior="@string/bottom_sheet_behavior"
                        app:behavior_hideable="true"
                        app:behavior_peekHeight="120dp"
                        app:gestureInsetBottomIgnored="true"
                        app:sheetLevel="@{uimodel.sheetLevel}" />

                <!-- Handle shown only while the sheet is HIDDEN (the sheet itself is below the edge then) -->
                <ImageView
                        android:id="@+id/settings_sheet_handle"
                        android:layout_width="72dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:src="@drawable/sheet_handle"
                        android:scaleType="center"
                        android:contentDescription="@string/sheet_handle_open"
                        android:visibility="gone"
                        tools:visibility="visible" />
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
                android:id="@+id/layout_topbar"
                layout="@layout/layout_main_topbar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                app:adjustTopBar="@{uimodel.screenAspectRatio}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/video_recording_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:background="#88000000"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

    </com.particlesdevs.photoncamera.ui.camera.CameraLayout>
</layout>
