<?xml version="1.0" encoding="utf-8"?>
<!-- P384: a row inside an open module card (ModuleSection): preference_card a step inward - 24dp in, a 30dp icon tile with an 18dp
     glyph, the title 14sp - on the nested fill SettingsCardDecoration draws under it. Same ids as preference_card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">
    <FrameLayout
        android:id="@+id/settings_icon_tile"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/settings_icon_tile_nested">
        <ImageView
            android:id="@android:id/icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:fontFamily="sans-serif-medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/settings_value_below"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/settings_text"
            android:textSize="12.5sp"
            android:visibility="gone" />
        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/settings_summary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/settings_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/settings_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxWidth="140dp"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="@color/settings_muted"
        android:textSize="13sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="16dp"
        android:orientation="vertical"
        android:paddingStart="8dp" />
</LinearLayout>
