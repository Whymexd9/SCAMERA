<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        >
    <data>

        <import type="com.particlesdevs.photoncamera.settings.PreferenceKeys"/>

        <import type="android.view.View"/>

        <variable
                name="timermodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.TimerFrameCountModel"/>
    </data>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true">
        <!--    Layout that contains viewfinder texture view-->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/texture_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingTop="@dimen/viewfinder_top_padding">

        <!--Viewfinder TextureView-->   <!--Aspect ratio of viewfinder = 3:4 -->

            <!--FocusCircleView-->
            <!--        putting focus circle here will make it
             not visible outside viewfinder container-->
            <com.particlesdevs.photoncamera.ui.camera.views.viewfinder.GLPreview
                    android:id="@+id/texture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <!-- P42: face boxes and the tracking box; never takes a touch. -->
            <com.particlesdevs.photoncamera.ui.camera.views.SubjectOverlayView
                    android:id="@+id/subjectOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:layout_constraintBottom_toBottomOf="@id/texture"
                    app:layout_constraintEnd_toEndOf="@id/texture"
                    app:layout_constraintStart_toStartOf="@id/texture"
                    app:layout_constraintTop_toTopOf="@id/texture" />

            <com.particlesdevs.photoncamera.ui.camera.views.FocusCircleView
                    android:id="@+id/touchFocus"
                    android:layout_width="@dimen/focus_circle_size"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    android:visibility="invisible"
                    android:color="@color/focus_circle_color"
                    android:thickness="1.5dp"
                    app:layout_constraintBottom_toBottomOf="@id/texture"
                    app:layout_constraintEnd_toEndOf="@id/texture"
                    app:layout_constraintStart_toStartOf="@id/texture"
                    app:layout_constraintTop_toTopOf="@id/texture"
                    tools:visibility="visible"/>

            <com.particlesdevs.photoncamera.ui.camera.views.viewfinder.SurfaceViewOverViewfinder
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:id="@+id/surfaceView"
                    app:layout_constraintBottom_toBottomOf="@id/texture"
                    app:layout_constraintEnd_toEndOf="@id/texture"
                    app:layout_constraintStart_toStartOf="@id/texture"
                    app:layout_constraintTop_toTopOf="@id/texture"
                    android:background="#00000000"
                    tools:visibility="visible" />

            <!-- P319: the wipe between two LUTs on a swipe (the old picture over the preview, cut away); never takes a touch. -->
            <com.particlesdevs.photoncamera.ui.camera.views.LutWipeView
                    android:id="@+id/lut_wipe"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:clickable="false"
                    android:focusable="false"
                    app:layout_constraintBottom_toBottomOf="@id/texture"
                    app:layout_constraintEnd_toEndOf="@id/texture"
                    app:layout_constraintStart_toStartOf="@id/texture"
                    app:layout_constraintTop_toTopOf="@id/texture" />

            <!-- Outline of the live area. Border only, no fill: the preview has to
                 show through. Not clickable, so it never eats a tap meant for
                 focus. -->
            <com.particlesdevs.photoncamera.ui.camera.views.ViewfinderFrame
                android:id="@+id/viewfinder_frame"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="false"
                android:focusable="false"
                app:layout_constraintTop_toTopOf="@+id/texture"
                app:layout_constraintBottom_toBottomOf="@+id/texture"
                app:layout_constraintStart_toStartOf="@+id/texture"
                app:layout_constraintEnd_toEndOf="@+id/texture" />

            <!-- SIMPLE_UI §1: the brightness sun beside the focus ring (CameraFragment places it on every tap). -->
            <com.particlesdevs.photoncamera.ui.camera.views.ExposureSunView
                android:id="@+id/ev_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- SIMPLE_UI §1: the LUT pill in the viewfinder's top-left corner (LutTray styles it and opens the tray). -->
            <TextView
                android:id="@+id/lut_pill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:maxWidth="180dp"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="LUT"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@+id/texture"
                app:layout_constraintStart_toStartOf="@+id/texture"
                tools:ignore="HardcodedText" />

            <!-- SIMPLE_UI §1: the focus / exposure lock pill (a long press), 20dp, top-right so it never meets the LUT pill. -->
            <TextView
                android:id="@+id/lock_pill"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textSize="11sp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@+id/texture"
                app:layout_constraintEnd_toEndOf="@+id/texture" />

            <com.particlesdevs.photoncamera.ui.camera.views.viewfinder.HorizonIndicatorView
                android:id="@+id/horizon_indicator_view"
                android:layout_width="420dp"
                android:layout_height="420dp"
                app:layout_constraintTop_toTopOf="@+id/texture"
                app:layout_constraintBottom_toBottomOf="@+id/texture"
                app:layout_constraintStart_toStartOf="@+id/texture"
                app:layout_constraintEnd_toEndOf="@+id/texture" />

            
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SIMPLE_UI §1: one progress indicator only (the ring round the thumbnail): the old 150dp centre circle stays gone. -->
        <ProgressBar
                android:id="@+id/capture_progress_bar"
                android:visibility="gone"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="@dimen/capture_progress_circle_size"
                android:layout_height="@dimen/capture_progress_circle_size"
                tools:progress="75"
                app:layout_constraintDimensionRatio="1:1"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/circular_progress_bar"
                android:layout_gravity="center"
                />

        <TextView
                android:id="@+id/frameTimer"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                tools:text="14:00"
                android:text="@{timermodel.timerCount}"
                android:textColor="@android:color/white"
                android:textSize="36sp"
                android:typeface="normal"
                android:visibility="gone"
                android:layout_gravity="center" />
    </FrameLayout>
</layout>