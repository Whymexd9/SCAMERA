<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
                name="top_bar_click_listener"
                type="android.view.View.OnClickListener"/>

        <variable
                name="uimodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel"/>
    </data>

    <!-- P25 top bar: two card badges (the merge route in effect, the save format) and the settings gear. Flash,
         self-timer and grid live in the quick-settings shade; the Quad toggle is gone. -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            tools:visibility="visible">

        <LinearLayout
                android:id="@+id/topbar_badges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/settings_button"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                    android:id="@+id/route_badge"
                    style="@style/ShadeBadge"
                    tools:drawableLeft="@drawable/settings_ic_layers"
                    tools:text="Склейка Hybrid"/>

            <TextView
                    android:id="@+id/format_badge"
                    style="@style/ShadeBadge"
                    android:layout_marginStart="8dp"
                    tools:drawableLeft="@drawable/ic_shade_jpeg"
                    tools:text="JPEG"/>
        </LinearLayout>

        <!-- The settings entry at every level (in FULL under the scrim: a tap there lowers the shade first). -->
        <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp" android:minHeight="0dp"
                android:onClick="@{top_bar_click_listener}"
                android:background="@drawable/shade_gear_card"
                android:src="@drawable/settings_ic_gear"
                android:scaleType="fitCenter"
                android:padding="11dp"
                android:contentDescription="@string/sheet_all_settings"
                android:tooltipText="@string/sheet_all_settings"
                bindRotate="@{uimodel}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
