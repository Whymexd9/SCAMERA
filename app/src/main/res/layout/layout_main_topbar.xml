<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
                name="top_bar_click_listener"
                type="android.view.View.OnClickListener"/>

        <variable
                name="uimodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel"/>
    </data>

    <!-- SIMPLE_UI §1 top bar (concept, 392dp; TopBar scales every size by UiScale): torch, timer (seconds badge), Motion as
         44dp icon buttons: on, a card pill with the accent icon and a label (torch, Motion) or a card circle with the seconds badge (timer); then one pill card [format | photo size | DCG];
         the gear, the only settings entry of the camera screen. No route badge and no manual summary: the Pro strip shows
         the values, so the bar never grows. TopBar steps the bar down (tighter gaps, smaller circles, 12sp) when it does not fit. -->
    <LinearLayout
            android:id="@+id/topbar_row"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clipChildren="false"
            tools:visibility="visible">

        <LinearLayout
                android:id="@+id/torch_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{top_bar_click_listener}">

            <ImageView
                    android:id="@+id/torch_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ui_ic_flash"
                    android:importantForAccessibility="no"/>

            <!-- Shown while the button is on (concept: «topbar_torch»), at the first fit level only. -->
            <TextView
                    android:id="@+id/torch_label"
                    style="@style/Scamera.TopBarLabel"
                    android:text="@string/topbar_torch"/>
        </LinearLayout>

        <FrameLayout
                android:id="@+id/timer_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:clipChildren="false"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{top_bar_click_listener}">

            <ImageView
                    android:id="@+id/timer_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ui_ic_timer"
                    android:importantForAccessibility="no"/>

            <!-- The seconds badge (concept: right 1, bottom 3, 18 x 16, 10sp bold ink on the accent, a 2dp black ring). -->
            <TextView
                    android:id="@+id/timer_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:minWidth="18dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="3dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:gravity="center"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:importantForAccessibility="no"/>
        </FrameLayout>

        <LinearLayout
                android:id="@+id/motion_mode_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="44dp"
                android:layout_marginStart="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="@{top_bar_click_listener}">

            <ImageView
                    android:id="@+id/motion_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ui_ic_motion"
                    android:importantForAccessibility="no"/>

            <!-- Shown while the button is on (concept: «topbar_motion»), at the first fit level only. -->
            <TextView
                    android:id="@+id/motion_label"
                    style="@style/Scamera.TopBarLabel"
                    android:text="@string/topbar_motion"/>
        </LinearLayout>

        <Space
                android:id="@+id/topbar_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:minWidth="0dp"/>

        <!-- One pill card, two (three) buttons divided by 1dp lines: format | photo size (| DCG where the module has it). -->
        <LinearLayout
                android:id="@+id/topbar_badges"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/topbar_group">

            <TextView
                    android:id="@+id/format_badge"
                    style="@style/Scamera.TopBarPillText"
                    android:onClick="@{top_bar_click_listener}"
                    tools:text="JPEG"/>

            <View
                    android:id="@+id/topbar_divider"
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="@color/settings_line"/>

            <TextView
                    android:id="@+id/size_badge"
                    style="@style/Scamera.TopBarPillText"
                    android:onClick="@{top_bar_click_listener}"
                    tools:text="12 Мп"/>

            <View
                    android:id="@+id/dcg_divider"
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:background="@color/settings_line"
                    android:visibility="gone"/>

            <TextView
                    android:id="@+id/dcg_badge"
                    style="@style/Scamera.TopBarPillText"
                    android:text="@string/topbar_dcg"
                    android:visibility="gone"
                    android:onClick="@{top_bar_click_listener}"/>
        </LinearLayout>

        <!-- The only settings entry of the camera screen. -->
        <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp" android:minHeight="0dp"
                android:onClick="@{top_bar_click_listener}"
                android:background="@null"
                android:src="@drawable/ui_ic_gear"
                android:scaleType="fitCenter"
                android:padding="10dp"
                android:contentDescription="@string/sheet_all_settings"
                android:tooltipText="@string/sheet_all_settings"
                bindRotate="@{uimodel}"/>

    </LinearLayout>
</layout>
