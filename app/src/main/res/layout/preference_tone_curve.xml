<?xml version="1.0" encoding="utf-8"?>
<!-- P144: the own tone curve - title, hint, the editable graph, its two shortcuts and the selected point's sliders
     (exposure and brightness, their values tap to type them), one settings card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/settings_card_gap"
    android:background="@drawable/settings_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">
    <TextView
        android:id="@android:id/title"
        android:fontFamily="sans-serif-medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/settings_text"
        android:textSize="16sp" />
    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/settings_summary"
        android:textSize="12.5sp" />
    <FrameLayout
        android:id="@+id/tone_curve_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:id="@+id/tone_curve_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal" />
    <LinearLayout
        android:id="@+id/tone_curve_point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp" />
</LinearLayout>
