<?xml version="1.0" encoding="utf-8"?>
<!-- P162: «Обрезка кадра» - title, hint and the picture of the frame (RawCropView): the black stripes the automatic crop
     found, the own margins, the kept frame with its size; its edges drag. One settings card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/settings_card_gap"
    android:background="@drawable/settings_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">
    <TextView
        android:id="@android:id/title"
        android:fontFamily="sans-serif-medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/settings_text"
        android:textSize="16sp" />
    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/settings_summary"
        android:textSize="12.5sp" />
    <FrameLayout
        android:id="@+id/raw_crop_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
</LinearLayout>
