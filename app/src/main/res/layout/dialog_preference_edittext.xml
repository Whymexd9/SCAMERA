<?xml version="1.0" encoding="utf-8"?>
<!-- The text dialog of an EditTextPreference that keeps the preference library's dialog (BackupPreferences): the dialog
     message and the app's text field (dialog_field), aligned with the title. Same ids as the library's
     preference_dialog_edittext. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@android:id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/settings_muted"
            android:textSize="15sp"
            android:lineSpacingExtra="3sp" />

        <EditText
            android:id="@android:id/edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@drawable/dialog_field"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/settings_text"
            android:textColorHint="@color/settings_muted"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
