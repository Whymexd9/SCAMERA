<?xml version="1.0" encoding="utf-8"?>
<!-- P6b route card: «Склейка» with a two-segment control Hybrid | SCAM HDR (RouteSelectorPreference). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/settings_card_gap"
    android:background="@drawable/settings_card"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/settings_text"
        android:textSize="17sp" />
    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/settings_muted"
        android:textSize="13sp" />
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/route_segments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal" />
</LinearLayout>
