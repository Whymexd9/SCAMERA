<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
                name="uimodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel"/>

        <variable
                name="auxmodel"
                type="com.particlesdevs.photoncamera.ui.camera.model.AuxButtonsModel"/>
    </data>

    <!-- P25 bottom bar (same height as before: whatever the 3:4 preview leaves), anchored at the bottom: the zoom
         ruler's place, the lens strip, then the shutter row. The quick-settings shade and its scrim end above this bar,
         so the strip works at every shade level and the ruler never covers the tiles. -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/layout_bottombar"
            android:clipChildren="false"
            android:clipToPadding="false">

        <!-- The zoom ruler (ZoomDialView, a small card) appears here, above the strip, while the zoom changes. -->
        <FrameLayout
                android:id="@+id/zoom_ruler_slot"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:clipChildren="false"
                android:layout_marginBottom="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/aux_buttons_container" />

        <com.particlesdevs.photoncamera.ui.camera.views.AuxButtonsLayout
                android:id="@+id/aux_buttons_container"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/aux_container_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottom_buttons"
                setAuxButtonModel="@{auxmodel}"
                setActiveId="@{auxmodel.currentCameraId}"
                bindViewGroupChildrenRotate="@{uimodel}" />

        <include
                android:id="@+id/bottom_buttons"
                layout="@layout/layout_bottombuttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
