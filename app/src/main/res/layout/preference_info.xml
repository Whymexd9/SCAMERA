<?xml version="1.0" encoding="utf-8"?>
<!-- P6b information row: the note of the module screen (i + text), no card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="14dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">
    <ImageView
        android:id="@+id/settings_info_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/settings_ic_info"
        android:tint="@color/settings_muted" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textColor="@color/settings_text"
            android:textSize="14sp" />
        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/settings_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
