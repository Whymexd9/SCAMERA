<?xml version="1.0" encoding="utf-8"?>
<!-- P6b row: icon, title, summary, value in the accent, trailing widget; the whole row is a card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/settings_card_gap"
    android:background="@drawable/settings_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="13dp"
    android:paddingEnd="12dp"
    android:paddingBottom="13dp">
    <ImageView
        android:id="@android:id/icon"
        android:layout_width="@dimen/settings_icon"
        android:layout_height="@dimen/settings_icon"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_text"
            android:textSize="16sp" />
        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/settings_muted"
            android:textSize="12.5sp" />
        <TextView
            android:id="@+id/settings_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13.5sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="16dp"
        android:orientation="vertical"
        android:paddingStart="10dp" />
</LinearLayout>
