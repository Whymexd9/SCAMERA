<?xml version="1.0" encoding="utf-8"?>
<!-- SIMPLE_UI §4 row (the concept's .row): a 36dp icon tile, the title (14.5sp) and its description (12.5sp, muted), the value
     on the right (muted) and the trailing widget (chevron / switch). The rows of a group share one card
     (SettingsCardDecoration), divided by lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">
    <FrameLayout
        android:id="@+id/settings_icon_tile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/settings_icon_tile">
        <ImageView
            android:id="@android:id/icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@android:id/title"
            android:fontFamily="sans-serif-medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_text"
            android:textSize="14.5sp" />
        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/settings_summary"
            android:textSize="12.5sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/settings_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxWidth="140dp"
        android:gravity="end"
        android:maxLines="2"
        android:textColor="@color/settings_muted"
        android:textSize="13sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minWidth="16dp"
        android:orientation="vertical"
        android:paddingStart="8dp" />
</LinearLayout>
