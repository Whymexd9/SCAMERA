<?xml version="1.0" encoding="utf-8"?>
<!-- Dark frosted pill used for every viewfinder control group.
     Near-black at ~65% so it separates from the scene without becoming a solid
     bar, with a faint light edge that keeps it visible over dark scenes too -
     a dark-on-dark panel with no edge disappears at night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#A60E1214" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
    <corners android:radius="999dp" />
</shape>
