<?xml version="1.0" encoding="utf-8"?>
<!-- Dark frosted pill for viewfinder controls. Near-black at ~65% so it reads as
     a panel over any scene, with a faint light edge to keep it from vanishing
     against a dark interior. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#A60E1214" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
    <corners android:radius="999dp" />
</shape>
