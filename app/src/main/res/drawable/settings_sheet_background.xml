<?xml version="1.0" encoding="utf-8"?>
<!-- Settings bottom sheet: the vf_settings_background glass at ~0.88 alpha,
     rounded only at the top. The item reaches 2dp below the view, so the
     stroke has no bottom edge (it is clipped). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0161B1F"/>
            <corners
                    android:topLeftRadius="22dp"
                    android:topRightRadius="22dp"/>
            <stroke
                    android:width="1dp"
                    android:color="#4050575B"/>
        </shape>
    </item>
</layer-list>
