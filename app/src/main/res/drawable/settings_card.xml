<?xml version="1.0" encoding="utf-8"?>
<!-- One preference = one card (P6b): CARD fill, 1dp LINE stroke, the radius of the module rows; ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_card"/>
            <stroke android:width="1dp" android:color="@color/settings_line"/>
            <corners android:radius="@dimen/settings_card_radius"/>
        </shape>
    </item>
</ripple>
