<?xml version="1.0" encoding="utf-8"?>
<!-- Settings gear of the camera top bar, 44dp square (P25): settings CARD with a LINE stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="@color/settings_card"/>
    <stroke android:width="1dp" android:color="@color/settings_line"/>
    <corners android:radius="16dp"/>
</shape>
