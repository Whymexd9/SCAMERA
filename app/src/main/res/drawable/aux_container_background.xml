<?xml version="1.0" encoding="utf-8"?>
<!-- The lens strip (P25): one CARD with a LINE stroke around the lens buttons; P171: corners 22dp (BottomChrome.style sets
     the tonal colours and the scaled radius at run time). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="@color/settings_card"/>
    <stroke android:width="1dp" android:color="@color/settings_line"/>
    <corners android:radius="22dp"/>
    <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"/>
</shape>
