<?xml version="1.0" encoding="utf-8"?>
<!-- 42dp circle of a quick button (mock .qbtn .c): white when the value differs from the default
     (the button is selected), faint glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/sheet_fg"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF"/>
        </shape>
    </item>
</selector>
