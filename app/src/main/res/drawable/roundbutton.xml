<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid white disc. The shutter is the only fully opaque white element on
         screen, which is what makes it findable without looking; nothing else
         competes for that weight. Only the shade moves between states, so the
         target never changes size under the finger. -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#D9D9D9"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#B0B0B0"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
</selector>
