<?xml version="1.0" encoding="utf-8"?>
<!-- P25 shutter: a ring in TEXT with a filled centre (concept). CameraUIViewImpl replaces it with the same shape in the
     camera accent for the pressed and self-timer states; this is the fallback and the layout preview. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="3dp" android:color="@color/settings_text"/></shape></item>
            <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
                <shape android:shape="oval"><solid android:color="#D8D8D8"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="3dp" android:color="@color/settings_text"/></shape></item>
            <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
                <shape android:shape="oval"><solid android:color="@color/settings_text"/></shape></item>
        </layer-list>
    </item>
</selector>
