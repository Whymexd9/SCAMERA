<?xml version="1.0" encoding="utf-8"?>
<!-- Flat white disc, as in the concept: no ring. The shutter is the only fully
     white element on screen, which is what marks it out; a ring around it added a
     second edge competing with the glass outlines everywhere else. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#D8D8D8"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#B0B0B0"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
</selector>
