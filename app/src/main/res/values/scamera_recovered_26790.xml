    <string name="noise_model_profile">Noise model profile</string>
    <string name="noise_model_import">Import noise model</string>
    <string name="noise_model_import_summary">Load a calibration file (.c) with A/B/C/D coefficients</string>
    <string name="noise_model_export">Export noise model</string>
    <string name="noise_model_export_summary">Save the active profile to Download/SCAMERA</string>
    <string name="merge_robustness">Merge robustness</string>
    <string name="merge_robustness_summary">Tolerance from the noise model; higher gives stronger noise reduction, lower gives fewer ghosts (HDR+ = 8)</string>
    <string name="merge_clip_level">Clipped highlight threshold</string>
    <string name="merge_clip_level_summary">Share of full scale above which a sample counts as clipped and is not merged in (0.99)</string>
    <string name="merge_tiling_tolerance">Tile mismatch tolerance</string>
    <string name="merge_tiling_tolerance_summary">Disagreement between neighbouring alignment tiles, in pixels, at which the field counts as invalid (4.0)</string>
    <string name="merge_floor_sigmas">Noise floor threshold</string>
    <string name="merge_floor_sigmas_summary">Short-frame samples below this many noise sigmas are not merged in; 0: no check (2.0)</string>
    <string name="merge_max_exposure_ratio">Exposure spread limit</string>
    <string name="merge_max_exposure_ratio_summary">Frames that differ from the reference by more than this are not merged; 0: no limit (64)</string>
    <string name="long_frame_shutter_cap">Long-frame shutter cap</string>
    <string name="long_frame_shutter_cap_summary">In sensor readout periods (1/30 s); the rest of the EV goes to gain. 0: no cap (2.0)</string>
    <string name="hdrplus_luma_gain_slope">Luma noise reduction: growth with ISO</string>
    <string name="hdrplus_luma_gain_slope_desc">How much stronger the luma noise reduction of the merge gets per doubling of ISO. 0: a fixed strength, as before</string>
    <string name="hdrplus_chroma_gain_slope">Chroma noise reduction: growth with ISO</string>
    <string name="hdrplus_chroma_gain_slope_desc">The same for the chroma noise reduction. Usually higher than for luma: colour speckle bothers sooner than grain, and removing it costs almost no detail</string>
    <string name="max_hdr_ratio">HDR ratio cap</string>
    <string name="max_hdr_ratio_summary">Limit on the ratio of the longest frame to the shortest; the short one is raised. GCam: 9.8 (night 15.3). 0: no cap</string>
    <string name="antibanding_hz">Flicker frequency, Hz</string>
    <string name="antibanding_hz_summary">The shutter of the Hybrid Shasta frames (taken after the press), when it is longer than the normal frames’, is rounded to a whole number of flicker periods. 120 for 60 Hz mains, 100 for 50 Hz, 0: no rounding</string>
    <string name="tet_model_enabled">TET exposure model</string>
    <string name="tet_model_enabled_summary">The shutter comes from the shutter/gain curve of the GCam dump and stays the same for the whole burst; the bracket differs only in gain. Off: the previous heuristics</string>
    <string name="mosaic_sr_enabled_desc">Super-resolution on the Bayer mosaic: scaling runs before demosaicing, on the raw samples</string>
    <string name="mosaic_sr_scale_desc">How many times the output resolution grows. Higher is sharper, but much slower and needs more memory</string>
    <string name="mosaic_sr_kernel_desc">Interpolation kernel for scaling. Affects edge sharpness and ringing</string>
    <string name="quad_bayer_enabled_desc">Capture from the Quad Bayer sensor at full resolution instead of 4:1 binning</string>
    <string name="quad_bayer_mode_desc">How the quad mosaic is handled: binning for a cleaner image or remosaic for detail</string>
    <string name="quad_dng_metadata_desc">Which CFA pattern to write to the DNG. A wrong one gives purple or broken colour in an editor</string>
    <string name="noise_model_profile_desc">Sensor noise profile. Sets which deviation counts as noise and which as real signal</string>
    <string name="zsl_merge_algorithm_desc">Merge algorithm for normal ZSL frames</string>
    <string name="night_merge_algorithm_desc">Merge algorithm in night mode</string>
    <string name="ai_denoise_model_desc">Neural network model for noise reduction. Larger ones are cleaner but slower</string>
    <string name="ai_denoise_strength_desc">Overall strength of the AI noise reduction. Too much wipes out texture</string>
    <string name="ai_denoise_luma_desc">AI noise reduction strength for luma: grain</string>
    <string name="ai_denoise_chroma_desc">AI noise reduction strength for chroma: colour blotches</string>
    <string name="wide169_desc">Shoot in 16:9 instead of the full sensor area. The frame is cropped at the top and bottom</string>
    <string name="short_frame_count_desc">How many short frames to capture to save highlights. 0: none</string>
    <string name="short_exposure_ev_desc">How much darker the short frame is than the base one, in stops</string>
    <string name="long_frame_count_desc">How many long frames to capture for shadow detail. 0: none</string>
    <string name="long_exposure_ev_desc">How much brighter the long frame is than the base one, in stops</string>
    <string name="highlight_suppression_desc">Highlight suppression in the merge: how strongly bright areas are compressed</string>
    <string name="binning_desc">Combines neighbouring pixels 4:1. Lower resolution, cleaner image in the dark</string>
    <string name="energy_safe_desc">Saves power: less load and heat at the cost of processing speed</string>
    <string name="camera_sounds_desc">Shutter sound when shooting</string>
    <string name="hide_gallery_icon_desc">Hide the separate gallery icon in the app list (the SCAMERA icon stays)</string>
