<resources xmlns:tools="http://schemas.android.com/tools">
    <!--Activity Themes-->

    <!-- Base application theme. -->
    <style name="Theme.Scamera.BaseApp" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="iconTint">?android:textColorPrimary</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="cameraFragmentBackground">@color/settings_bg</item>
        <item name="modeSelectedTextColor">?attr/colorControlActivated</item>
        <item name="processingProgressColor">?attr/colorAccent</item>
        <!-- every alert dialog in the app's look (DialogStyle); the framework one only as a fallback -->
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/AlertDialogTheme.Framework</item>
        <item name="android:fontFamily">@font/open_sans</item>
    </style>

    <style name="Theme.Scamera.Splash" parent="Theme.Scamera.BaseApp">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.Scamera.SettingsActivity" parent="Theme.Scamera.BaseApp">

    </style>

    <!--    <style name="Theme.Scamera.CameraActivity" parent="Theme.AppCompat.NoActionBar">-->
    <!--        <item name="android:windowNoTitle">true</item>-->
    <!--        <item name="android:windowActionBar">false</item>-->
    <!--        <item name="android:windowFullscreen">true</item>-->
    <!--        <item name="android:windowContentOverlay">@null</item>-->
    <!--        <item name="colorPrimary">@color/colorPrimary</item>-->
    <!--        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>-->
    <!--        <item name="colorAccent">@color/colorAccent</item>-->
    <!--    </style>-->

    <!--Other Styles-->
    <style name="BoldTextWithShadow">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">@android:color/black</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>
    <style name="TextWithShadow" parent="BoldTextWithShadow">
        <item name="android:textStyle">normal</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="AuxButtonText">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/black_white_selectable</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PreferenceActionBarStyle">
        <item name="titleTextAppearance">@style/SettingsTitleTextAppearance</item>
    </style>

    <style name="SettingsTitleTextAppearance">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <!--
        The app's alert dialogs (owner, 2026-10-28: «исправь стиль всех таких меню которые выбиваются из нашего стиля
        приложения»): the settings card (settings_card, a faint settings_line outline, 24dp corners), a white 20sp medium
        title, muted 15sp body text, sentence-case buttons - «Отмена» a quiet text button, the confirm an accent pill like a
        chosen chip, a side action in accent text - and the settings' accent radio in lists. Every colour is explicit: the
        dialog stays dark on a light system theme and on the dynamic-colour accent overlays. DialogStyle.builder takes it
        with the Material builder; the base theme's alertDialogTheme gives it to the androidx dialogs built elsewhere (the
        preference library's backup, restore and reset), with the same card as the window background.
    -->
    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/Scamera.Dialog</item>
        <item name="android:windowBackground">@drawable/dialog_window</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="dialogCornerRadius">@dimen/dialog_radius</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_radius</item>
        <item name="dialogPreferredPadding">24dp</item>
        <item name="colorSurface">@color/settings_card</item>
        <item name="colorSurfaceContainerHigh">@color/settings_card</item>
        <item name="android:colorBackground">@color/settings_card</item>
        <item name="colorOnSurface">@color/settings_text</item>
        <item name="colorOnSurfaceVariant">@color/settings_muted</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_muted</item>
        <item name="android:textColorHint">@color/settings_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/settings_text</item>
        <item name="colorControlNormal">@color/settings_muted</item>
        <item name="colorControlHighlight">@color/settings_ripple</item>
        <item name="android:colorControlHighlight">@color/settings_ripple</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="isLightTheme">false</item>
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/Scamera.Dialog.TitlePanel</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Scamera.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Scamera.Dialog.Body</item>
        <item name="buttonBarButtonStyle">@style/Scamera.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Scamera.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Scamera.Dialog.Button.Side</item>
        <item name="buttonBarPositiveButtonStyle">@style/Scamera.Dialog.Button.Confirm</item>
    </style>

    <!-- The dialog: the Material 3 layout with the app's list rows; the background insets are dialog_window's. -->
    <style name="Scamera.Dialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/settings_card</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scamera.Dialog</item>
        <item name="backgroundInsetStart">@dimen/dialog_inset_horizontal</item>
        <item name="backgroundInsetEnd">@dimen/dialog_inset_horizontal</item>
        <item name="backgroundInsetTop">@dimen/dialog_inset_vertical</item>
        <item name="backgroundInsetBottom">@dimen/dialog_inset_vertical</item>
        <item name="listItemLayout">@layout/dialog_item</item>
        <item name="singleChoiceItemLayout">@layout/dialog_item_single</item>
        <item name="multiChoiceItemLayout">@layout/dialog_item_multi</item>
    </style>

    <style name="ShapeAppearance.Scamera.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialog_radius</item>
    </style>

    <style name="ShapeAppearance.Scamera.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Scamera.Dialog.TitlePanel" parent="MaterialAlertDialog.Material3.Title.Panel">
        <item name="android:paddingTop">24dp</item>
    </style>

    <!-- As the settings page header: 20sp, medium, the text colour; long titles wrap instead of being cut. -->
    <style name="Scamera.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Scamera.DialogTitle</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="TextAppearance.Scamera.DialogTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- The message: the app font, 15sp, the muted text colour, with room between the lines. -->
    <style name="Scamera.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Scamera.DialogBody</item>
        <item name="android:textColor">@color/settings_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="TextAppearance.Scamera.DialogBody" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/settings_muted</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="fontFamily">@font/open_sans</item>
    </style>

    <!-- «Отмена»: a quiet text button in the text colour, sentence case. -->
    <style name="Scamera.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.Scamera.DialogButton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dialog_quiet_text</item>
        <item name="rippleColor">@color/settings_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scamera.Pill</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginLeft">4dp</item>
    </style>

    <!-- A side action (neutral, at the start): accent text. -->
    <style name="Scamera.Dialog.Button.Side">
        <item name="android:textColor">@color/dialog_link_text</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginLeft">0dp</item>
    </style>

    <!-- The confirm (positive, also «Сбросить» / «Удалить»): a filled accent pill with dark text, like a chosen chip. -->
    <style name="Scamera.Dialog.Button.Confirm" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Scamera.DialogButton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/dialog_positive_text</item>
        <item name="backgroundTint">@color/dialog_positive_fill</item>
        <item name="rippleColor">@color/settings_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Scamera.Pill</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TextAppearance.Scamera.DialogButton" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!--
        A fallback for anything still built on the framework's android.app.AlertDialog (the app builds none: DialogStyle);
        OEM ROMs may restyle the framework dialog, so this is only the closest the framework theme gets.
    -->
    <style name="AlertDialogTheme.Framework" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_window</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/dialog_radius</item>
        <item name="android:colorBackground">@color/settings_card</item>
        <item name="android:textColorPrimary">@color/settings_text</item>
        <item name="android:textColorSecondary">@color/settings_muted</item>
        <item name="android:textColorAlertDialogListItem">@color/settings_text</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlNormal">@color/settings_muted</item>
        <item name="android:colorControlHighlight">@color/settings_ripple</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <item name="android:windowTitleStyle">@style/AlertDialogTheme.Framework.Title</item>
        <item name="android:buttonBarButtonStyle">@style/AlertDialogTheme.Framework.Button</item>
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="AlertDialogTheme.Framework.Title" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Scamera.DialogTitle</item>
        <item name="android:maxLines">4</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="AlertDialogTheme.Framework.Button" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="LensMenuRow">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableStart">@drawable/ic_info</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- P25 gallery thumbnail inside its 18dp card. -->
    <style name="ShapeAppearance.Scamera.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">15dp</item>
    </style>
    <!-- SIMPLE_UI §1: the label of an active top-bar button (concept .tb .lbl: 13sp, 600, 6dp after the icon). -->
    <style name="Scamera.TopBarLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:visibility">gone</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- SIMPLE_UI §1: a button of the top bar's pill card (format, size, DCG), 13sp semibold, one line. -->
    <style name="Scamera.TopBarPillText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
