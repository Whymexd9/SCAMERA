<?xml version="1.0" encoding="utf-8"?>
<!-- Settings look (P6b): the tokens of «Камеры и сенсоры». SettingsStyle.java holds the same values for views built in code. -->
<resources>
    <color name="settings_bg">#FF101416</color>
    <color name="settings_card">#FF1B2023</color>
    <color name="settings_text">#FFF4F3F7</color>
    <color name="settings_muted">#FFB2BAC9</color>
    <!-- P139: a row's description, a step dimmer than settings_muted; titles are medium weight (UiTokens.SUMMARY / title) -->
    <color name="settings_summary">#FF959EAD</color>
    <color name="settings_line">#FF30363C</color>
    <color name="settings_field">#FF121417</color>
    <color name="settings_sheet">#FF202428</color>
    <color name="settings_warn">#FFFFB4A8</color>
    <!-- text and icons on an accent fill (UiTokens.INK): the confirm pill of a dialog -->
    <color name="settings_ink">#FF17141F</color>
    <!-- the press ripple of a dialog's rows and quiet buttons on the card -->
    <color name="settings_ripple">#1FFFFFFF</color>
    <!-- The alert dialogs (DialogStyle, AlertDialogTheme): 24dp corners, the card 16dp inside the window's sides (26dp from
         a 392dp screen's edge at the window's 95 %) and 24dp above and below. -->
    <dimen name="dialog_radius">24dp</dimen>
    <dimen name="dialog_inset_horizontal">16dp</dimen>
    <dimen name="dialog_inset_vertical">24dp</dimen>
    <dimen name="settings_card_radius">12dp</dimen>
    <dimen name="settings_card_gap">10dp</dimen>
    <dimen name="settings_icon">27dp</dimen>
</resources>
