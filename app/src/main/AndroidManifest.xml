        <!-- Activity alias for launcher icon - can be enabled/disabled programmatically -->
        <activity-alias
                android:name="com.particlesdevs.photoncamera.gallery.ui.GalleryActivityLauncher"
                android:targetActivity="com.particlesdevs.photoncamera.gallery.ui.GalleryActivity"
                android:label="@string/gallery_name"
                android:icon="@mipmap/ic_gallery_launcher"
                android:roundIcon="@mipmap/ic_gallery_launcher_round"
                android:enabled="true"
                android:exported="true">
            <!-- Launcher intent - Shows SGallery in app drawer -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
