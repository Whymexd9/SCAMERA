<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/manual_mode" android:layout_width="match_parent" android:layout_height="wrap_content">
    <FrameLayout android:id="@+id/knobViewContainer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="8dp"
        android:background="@drawable/glass_pill">
        <com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobView
            android:id="@+id/knobView" android:layout_width="match_parent" android:layout_height="67.2dp" android:visibility="gone" />
        <com.particlesdevs.photoncamera.circularbarlib.ui.views.scaleview.LinearScaleView
            android:id="@+id/linearScaleView" android:layout_width="match_parent" android:layout_height="61.6dp" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/buttons_container" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_below="@id/knobViewContainer" android:padding="3dp"
        android:orientation="horizontal" android:background="@drawable/glass_pill">
        <TextView android:id="@+id/ev_option_tv" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:text="" android:contentDescription="Экспокоррекция" android:foreground="@drawable/concept_manual_ev" android:foregroundGravity="center"
            android:gravity="center" android:textSize="13sp" android:includeFontPadding="false"
            android:textColor="@color/manual_text_color" android:background="@drawable/manual_tab_background"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/exposure_option_tv" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:text="" android:contentDescription="Выдержка" android:foreground="@drawable/concept_manual_exposure" android:foregroundGravity="center"
            android:gravity="center" android:textSize="13sp" android:includeFontPadding="false"
            android:textColor="@color/manual_text_color" android:background="@drawable/manual_tab_background"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/iso_option_tv" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:text="" android:contentDescription="ISO" android:foreground="@drawable/concept_manual_iso" android:foregroundGravity="center"
            android:gravity="center" android:textSize="13sp" android:includeFontPadding="false"
            android:textColor="@color/manual_text_color" android:background="@drawable/manual_tab_background"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/wb_option_tv" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:text="" android:contentDescription="Баланс белого" android:foreground="@drawable/concept_manual_wb" android:foregroundGravity="center"
            android:gravity="center" android:textSize="13sp" android:includeFontPadding="false"
            android:textColor="@color/manual_text_color" android:background="@drawable/manual_tab_background"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/focus_option_tv" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1" android:text="" android:contentDescription="Фокус" android:foreground="@drawable/concept_manual_focus" android:foregroundGravity="center"
            android:gravity="center" android:textSize="13sp" android:includeFontPadding="false"
            android:textColor="@color/manual_text_color" android:background="@drawable/manual_tab_background"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>
</RelativeLayout>
