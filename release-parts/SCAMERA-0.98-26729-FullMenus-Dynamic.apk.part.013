valid.y = (sys0.x >= 0 && sys0.x % stride_h == 0 && sys0.x / stride_h < psc(h) && sxs0.y >= 0 && sxs0.y % stride_w == 0 && sxs0.y / stride_w < psc(w));
valid.z = (sys0.y >= 0 && sys0.y % stride_h == 0 && sys0.y / stride_h < psc(h) && sxs0.x >= 0 && sxs0.x % stride_w == 0 && sxs0.x / stride_w < psc(w));
valid.w = (sys0.y >= 0 && sys0.y % stride_h == 0 && sys0.y / stride_h < psc(h) && sxs0.y >= 0 && sxs0.y % stride_w == 0 && sxs0.y / stride_w < psc(w));
