if (sxs < 0 || sxs % stride_w != 0)
continue;
int sx = sxs / stride_w;
if (sx >= psc(w))
continue;
int v_offset = v_offset_0 + sy * psc(w) + sx;
int w_offset = w_offset_0 + y * kernel_w + x;
sum += buffer_ld1(weight_data, w_offset) * buffer_ld1(bottom_blob_data, v_offset);
}
}
sum = activation_afp(sum, activation_type, activation_param_0, activation_param_1);
