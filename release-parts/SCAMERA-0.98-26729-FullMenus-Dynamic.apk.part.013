return;
afpvec4 v1 = buffer_ld4(bottom_blob1_data, gi);
afpvec4 v2 = buffer_ld4(bottom_blob2_data, gi);
afpvec4 res;
if (coeff_term == 0)
{
if (op_type == 0)
res = v1 * v2;
if (op_type == 1)
res = v1 + v2;
if (op_type == 2)
res = max(v1, v2);
}
else
{
if (op_type == 0)
res = v1 * v2;
if (op_type == 1)
res = v1 * afp(p.coeff0) + v2 * afp(p.coeff1);
if (op_type == 2)
res = max(v1, v2);
}
buffer_st4(top_blob_data, gi, res);
}
