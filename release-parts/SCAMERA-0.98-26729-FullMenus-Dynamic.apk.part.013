int out_h;
int out_d;
int out_c;
int out_dims;
int out_cstep;
int reduce_w;
int reduce_h;
int reduce_d;
int reduce_c;
int map_out_w;
int map_out_h;
int map_out_d;
int map_out_c;
float coeff;
} p;
shared lfp sdata[256];
const float FLT_MAX_VALUE = 3.402823466e+38;
const float FLT_MIN_VALUE = 1.175494351e-38;
afp init_acc()
{
if (op == 6) return afp(1.f);
if (op == 4) return afp(-FLT_MAX_VALUE);
if (op == 5) return afp(FLT_MAX_VALUE);
return afp(0.f);
}
afp element_accum(afp acc, afp v)
{
if (op == 0 || op == 3 || op == 9) return acc + v;
if (op == 1 || op == 7) return acc + abs(v);
if (op == 2 || op == 8) return acc + v * v;
if (op == 4) return max(acc, v);
if (op == 5) return min(acc, v);
if (op == 6) return acc * v;
if (op == 10) return acc + exp(v);
return acc + v;
}
afp combine_accum(afp a, afp b)
{
if (op == 4) return max(a, b);
if (op == 5) return min(a, b);
if (op == 6) return a * b;
return a + b;
}
#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
afp subgroup_reduce_acc(afp v)
{
if (op == 4) return subgroupMax(v);
if (op == 5) return subgroupMin(v);
if (op == 6) return subgroupMul(v);
return subgroupAdd(v);
}
#endif
void decode_out(int out_index, out int ow, out int oh, out int od, out int oc)
{
ow = 0;
oh = 0;
od = 0;
oc = 0;
if (p.out_dims == 1)
{
ow = out_index;
}
else if (p.out_dims == 2)
{
ow = out_index % p.out_w;
oh = out_index / p.out_w;
}
else if (p.out_dims == 3)
{
ow = out_index % p.out_w;
int t = out_index / p.out_w;
oh = t % p.out_h;
oc = t / p.out_h;
}
else
{
ow = out_index % p.out_w;
int t0 = out_index / p.out_w;
oh = t0 % p.out_h;
int t1 = t0 / p.out_h;
od = t1 % p.out_d;
oc = t1 / p.out_d;
}
}
int in_index(int iw, int ih, int id, int ic)
{
if (p.in_dims == 1) return iw;
if (p.in_dims == 2) return ih * p.in_w + iw;
if (p.in_dims == 3) return ic * p.in_cstep + ih * p.in_w + iw;
int in_dstep = p.in_w * p.in_h;
if (p.in_d > 1) in_dstep = p.in_cstep / p.in_d;
return ic * p.in_cstep + id * in_dstep + ih * p.in_w + iw;
}
int out_offset(int ow, int oh, int od, int oc)
{
if (p.out_dims == 1) return ow;
if (p.out_dims == 2) return oh * p.out_w + ow;
if (p.out_dims == 3) return oc * p.out_cstep + oh * p.out_w + ow;
int out_dstep = p.out_w * p.out_h;
if (p.out_d > 1) out_dstep = p.out_cstep / p.out_d;
return oc * p.out_cstep + od * out_dstep + oh * p.out_w + ow;
}
afp finalize_out(afp outv)
{
if (op == 9 || op == 10) outv = log(outv);
if (op == 8) outv = sqrt(outv < afp(FLT_MIN_VALUE) ? afp(0.f) : outv);
if (p.coeff != 1.f) outv = outv * afp(p.coeff);
return outv;
}
void main()
{
const int out_index = int(gl_WorkGroupID.y);
const int tid = int(gl_LocalInvocationID.x);
int ow, oh, od, oc;
decode_out(out_index, ow, oh, od, oc);
int in_coord[4] = int[4](0, 0, 0, 0);
if (p.map_out_w >= 0) in_coord[p.map_out_w] = ow;
if (p.map_out_h >= 0) in_coord[p.map_out_h] = oh;
if (p.map_out_d >= 0) in_coord[p.map_out_d] = od;
if (p.map_out_c >= 0) in_coord[p.map_out_c] = oc;
int in_w = p.in_w;
int in_h = (p.in_h > 0) ? p.in_h : 1;
int in_d = (p.in_d > 0) ? p.in_d : 1;
int in_c = (p.in_c > 0) ? p.in_c : 1;
int reduce_size = 1;
if (p.reduce_w != 0) reduce_size *= in_w;
if (p.reduce_h != 0) reduce_size *= in_h;
if (p.in_dims == 4 && p.reduce_d != 0) reduce_size *= in_d;
if (p.in_dims >= 3 && p.reduce_c != 0) reduce_size *= in_c;
afp acc = init_acc();
for (int t = tid; t < reduce_size; t += 256)
{
int tt = t;
int iw = in_coord[3];
int ih = in_coord[2];
int id = in_coord[1];
int ic = in_coord[0];
if (p.reduce_w != 0)
{
iw = tt % in_w;
tt /= in_w;
}
if (p.reduce_h != 0)
{
ih = tt % in_h;
tt /= in_h;
}
if (p.in_dims == 4 && p.reduce_d != 0)
{
id = tt % in_d;
tt /= in_d;
}
if (p.in_dims >= 3 && p.reduce_c != 0) { ic = tt % in_c; }
afp v = buffer_ld1(bottom_blob_data, in_index(iw, ih, id, ic));
acc = element_accum(acc, v);
}
#if ncnn_subgroup_basic && ncnn_subgroup_arithmetic && (!NCNN_fp16_arithmetic || ncnn_shaderSubgroupExtendedTypes)
afp sg = subgroup_reduce_acc(acc);
if (subgroupElect())
{
sdata[int(gl_SubgroupID)] = afp2lfp(sg);
}
barrier();
#if ncnn_subgroupSize >= 16
if (int(gl_SubgroupID) == 0)
{
const int lane = int(gl_SubgroupInvocationID);
const int num_sg = int(gl_NumSubgroups);
afp v = lane < num_sg ? lfp2afp(sdata[lane]) : init_acc();
afp outv = subgroup_reduce_acc(v);
if (subgroupElect())
{
outv = finalize_out(outv);
buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
}
}
#elif ncnn_subgroupSize == 8
if (int(gl_SubgroupID) < 4)
{
const int lane = int(gl_SubgroupInvocationID);
const int base = int(gl_SubgroupID) * 8;
afp v = lfp2afp(sdata[base + lane]);
afp r = subgroup_reduce_acc(v);
if (subgroupElect())
{
sdata[int(gl_SubgroupID)] = afp2lfp(r);
}
}
barrier();
if (int(gl_SubgroupID) == 0)
{
const int lane = int(gl_SubgroupInvocationID);
afp v = lane < 4 ? lfp2afp(sdata[lane]) : init_acc();
afp outv = subgroup_reduce_acc(v);
if (subgroupElect())
{
outv = finalize_out(outv);
buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
}
}
#elif ncnn_subgroupSize == 4
if (int(gl_SubgroupID) < 16)
{
const int lane = int(gl_SubgroupInvocationID);
const int base = int(gl_SubgroupID) * 4;
afp v = lfp2afp(sdata[base + lane]);
afp r = subgroup_reduce_acc(v);
if (subgroupElect())
{
sdata[int(gl_SubgroupID)] = afp2lfp(r);
}
}
barrier();
if (int(gl_SubgroupID) < 4)
{
const int lane = int(gl_SubgroupInvocationID);
const int base = int(gl_SubgroupID) * 4;
afp v = lfp2afp(sdata[base + lane]);
afp r = subgroup_reduce_acc(v);
if (subgroupElect())
{
sdata[int(gl_SubgroupID)] = afp2lfp(r);
}
}
barrier();
if (int(gl_SubgroupID) == 0)
{
const int lane = int(gl_SubgroupInvocationID);
afp v = lfp2afp(sdata[lane]);
afp outv = subgroup_reduce_acc(v);
if (subgroupElect())
{
outv = finalize_out(outv);
buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
}
}
#else
{
const int num_sg = 256 / ncnn_subgroupSize;
for (int stride = num_sg / 2; stride > 0; stride >>= 1)
{
if (tid < stride)
{
afp a = lfp2afp(sdata[tid]);
afp b = lfp2afp(sdata[tid + stride]);
sdata[tid] = afp2lfp(combine_accum(a, b));
}
barrier();
}
if (tid == 0)
{
afp outv = lfp2afp(sdata[0]);
outv = finalize_out(outv);
buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
}
}
#endif
#else
sdata[tid] = afp2lfp(acc);
barrier();
for (int stride = 128; stride > 0; stride >>= 1)
{
if (tid < stride)
{
afp a = lfp2afp(sdata[tid]);
afp b = lfp2afp(sdata[tid + stride]);
sdata[tid] = afp2lfp(combine_accum(a, b));
}
barrier();
}
if (tid == 0)
{
afp outv = lfp2afp(sdata[0]);
outv = finalize_out(outv);
buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
}
#endif
}
#version 450
layout(constant_id = 0) const float slope = 0;
#define shape_constant_id_offset 1
layout(constant_id = shape_constant_id_offset + 0) const uint n = 0;
layout(binding = 0) buffer bottom_top_blob { sfpvec4 bottom_top_blob_data[]; };
layout(push_constant) uniform parameter
{
uint n;
} p;
void main()
{
uint gi = gl_GlobalInvocationID.x;
if (gi >= psc(n))
return;
afpvec4 v = buffer_ld4(bottom_top_blob_data, gi);
if (slope == 0)
v = max(v, afp(0.f));
else
v = mix(v, v * afp(slope), lessThan(v, afpvec4(0.f)));
buffer_st4(bottom_top_blob_data, gi, v);
}
#version 450
layout(constant_id = 0) const int ndim = 0;
#define shape_constant_id_offset 1
layout(constant_id = shape_constant_id_offset + 0) const int dims = 0;
layout(constant_id = shape_constant_id_offset + 1) const int w = 0;
layout(constant_id = shape_constant_id_offset + 2) const int h = 0;
layout(constant_id = shape_constant_id_offset + 3) const int d = 0;
layout(constant_id = shape_constant_id_offset + 4) const int c = 0;
layout(constant_id = shape_constant_id_offset + 5) const int cstep = 0;
layout(constant_id = shape_constant_id_offset + 6) const int outdims = 0;
layout(constant_id = shape_constant_id_offset + 7) const int outw = 0;
layout(constant_id = shape_constant_id_offset + 8) const int outh = 0;
layout(constant_id = shape_constant_id_offset + 9) const int outd = 0;
layout(constant_id = shape_constant_id_offset + 10) const int outc = 0;
layout(constant_id = shape_constant_id_offset + 11) const int outcstep = 0;
layout(binding = 0) readonly buffer bottom_blob { sfp bottom_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { sfp top_blob_data[]; };
layout(push_constant) uniform parameter
{
int dims;
int w;
int h;
int d;
int c;
int cstep;
int outdims;
int outw;
int outh;
int outd;
int outc;
int outcstep;
} p;
void main()
{
int gx = int(gl_GlobalInvocationID.x);
int gy = int(gl_GlobalInvocationID.y);
int gz = int(gl_GlobalInvocationID.z);
if (gx >= psc(outw) || gy >= psc(outh) * psc(outd) || gz >= psc(outc))
return;
int i;
if (ndim == 1) i = gx;
if (ndim == 2) i = gy * psc(outw) + gx;
if (ndim == 3) i = gz * psc(outh) * psc(outw) + gy * psc(outw) + gx;
if (ndim == 4) i = gz * psc(outd) * psc(outh) * psc(outw) + gy * psc(outw) + gx;
int x;
int y;
int z;
if (psc(dims) == 1)
{
z = 0;
y = 0;
x = i;
}
else if (psc(dims) == 2)
{
z = 0;
y = i / psc(w);
x = i % psc(w);
}
else if (psc(dims) == 3)
{
int size = psc(w) * psc(h);
z = i / size;
y = i % size / psc(w);
x = i % size % psc(w);
}
else 
{
int size = psc(w) * psc(h) * psc(d);
int dsize = psc(w) * psc(h);
z = i / size;
int yd = i % size / dsize;
int yh = i % size % dsize / psc(w);
x = i % size % dsize % psc(w);
y = yd * psc(h) + yh;
}
int v_offset = z * psc(cstep) + y * psc(w) + x;
int gi;
if (ndim == 1) gi = gx;
if (ndim == 2) gi = gy * psc(outw) + gx;
if (ndim == 3 || ndim == 4) gi = gz * psc(outcstep) + gy * psc(outw) + gx;
buffer_cp1(top_blob_data, gi, bottom_blob_data, v_offset);
}
#version 450
layout(constant_id = 0) const int input_batch_axis = 233;
layout(constant_id = 1) const int output_batch_axis = 233;
layout(binding = 0) readonly buffer bottom_blob { sfp bottom_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { sfp top_blob_data[]; };
layout(push_constant) uniform parameter
{
int dims;
int w;
int h;
int d;
int c;
int cstep;
int n;
int nstep;
int outdims;
int outw;
int outh;
int outd;
int outc;
int outcstep;
int outn;
int outnstep;
} p;
void main()
{
int gx = int(gl_GlobalInvocationID.x);
int gy = int(gl_GlobalInvocationID.y);
int gz = int(gl_GlobalInvocationID.z);
if (gx >= p.outw || gy >= p.outh * p.outd || gz >= p.outc * p.outn)
return;
int output_axis = output_batch_axis;
int output_dims = p.outdims + (output_axis == 233 ? 0 : 1);
if (output_axis < 0)
output_axis += output_dims;
int input_axis = input_batch_axis;
int input_dims = p.dims + (input_axis == 233 ? 0 : 1);
if (input_axis < 0)
input_axis += input_dims;
int out_b = gz / p.outc;
int out_q = gz - out_b * p.outc;
int out_pcoord[4];
if (p.outdims == 1)
out_pcoord[0] = gx;
if (p.outdims == 2)
{
out_pcoord[0] = gy;
out_pcoord[1] = gx;
}
if (p.outdims == 3)
{
out_pcoord[0] = out_q;
out_pcoord[1] = gy;
out_pcoord[2] = gx;
}
if (p.outdims == 4)
{
out_pcoord[0] = out_q;
out_pcoord[1] = gy / p.outh;
out_pcoord[2] = gy - out_pcoord[1] * p.outh;
out_pcoord[3] = gx;
}
int out_coord[5];
int pi = 0;
for (int i = 0; i < output_dims; i++)
{
if (i == output_axis)
out_coord[i] = out_b;
else
out_coord[i] = out_pcoord[pi++];
}
int out_pshape[4];
if (p.outdims == 1)
out_pshape[0] = p.outw;
if (p.outdims == 2)
{
out_pshape[0] = p.outh;
out_pshape[1] = p.outw;
}
if (p.outdims == 3)
{
out_pshape[0] = p.outc;
out_pshape[1] = p.outh;
out_pshape[2] = p.outw;
}
if (p.outdims == 4)
{
out_pshape[0] = p.outc;
out_pshape[1] = p.outd;
out_pshape[2] = p.outh;
out_pshape[3] = p.outw;
}
int out_shape[5];
pi = 0;
for (int i = 0; i < output_dims; i++)
{
if (i == output_axis)
out_shape[i] = p.outn;
else
out_shape[i] = out_pshape[pi++];
}
int src_i = 0;
for (int i = 0; i < output_dims; i++)
src_i = src_i * out_shape[i] + out_coord[i];
int in_pshape[4];
if (p.dims == 1)
in_pshape[0] = p.w;
if (p.dims == 2)
{
in_pshape[0] = p.h;
in_pshape[1] = p.w;
}
if (p.dims == 3)
{
in_pshape[0] = p.c;
in_pshape[1] = p.h;
in_pshape[2] = p.w;
}
if (p.dims == 4)
{
in_pshape[0] = p.c;
in_pshape[1] = p.d;
in_pshape[2] = p.h;
in_pshape[3] = p.w;
}
int in_shape[5];
pi = 0;
for (int i = 0; i < input_dims; i++)
{
if (i == input_axis)
in_shape[i] = p.n;
else
in_shape[i] = in_pshape[pi++];
}
int in_coord[5];
for (int i = input_dims - 1; i >= 0; i--)
{
in_coord[i] = src_i % in_shape[i];
src_i = src_i / in_shape[i];
}
int src_b = 0;
int in_pcoord[4];
pi = 0;
for (int i = 0; i < input_dims; i++)
{
if (i == input_axis)
src_b = in_coord[i];
else
in_pcoord[pi++] = in_coord[i];
}
int src_offset = src_b * p.nstep;
if (p.dims == 1)
src_offset += in_pcoord[0];
if (p.dims == 2)
src_offset += in_pcoord[0] * p.w + in_pcoord[1];
if (p.dims == 3)
src_offset += in_pcoord[0] * p.cstep + in_pcoord[1] * p.w + in_pcoord[2];
if (p.dims == 4)
src_offset += in_pcoord[0] * p.cstep + (in_pcoord[1] * p.h + in_pcoord[2]) * p.w + in_pcoord[3];
int dst_offset = out_b * p.outnstep;
if (p.outdims == 1)
dst_offset += gx;
if (p.outdims == 2)
dst_offset += gy * p.outw + gx;
if (p.outdims == 3 || p.outdims == 4)
dst_offset += out_q * p.outcstep + gy * p.outw + gx;
buffer_cp1(top_blob_data, dst_offset, bottom_blob_data, src_offset);
}
